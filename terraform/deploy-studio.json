{
  "schema_version": 2,
  "project_id": "aidp-ai-gods-eye-view",
  "terraform": {
    "path": "terraform",
    "package_oci_credentials": false
  },
  "capabilities": {
    "compartment_modes": [
      "new",
      "existing"
    ],
    "default_compartment_name": "aidp-gods-eye-view",
    "database_profile": "none",
    "region_selection": "subscribed_compatible",
    "regional_requirements": [
      "aidp",
      "genai_chat"
    ]
  },
  "presentation": {
    "title": "God’s Eye View",
    "summary": "Independent territorial viewer with integrated social and sensor controls, AIDP Gold queries and verified OCI access. Installation and updates run through Deploy Studio.",
    "tags": [
      "AI Data Platform Workbench",
      "Object Storage",
      "VM"
    ],
    "href": "https://github.com/jgangini/aidp-ai-gods-eye-view"
  },
  "run_steps": [
    {
      "key": "queue",
      "label": "Queue"
    },
    {
      "key": "credentials",
      "label": "Operator identity"
    },
    {
      "key": "plan",
      "label": "Resource plan"
    },
    {
      "key": "apply",
      "label": "Apply selected resources"
    },
    {
      "key": "application",
      "label": "AIDP and viewer verification"
    },
    {
      "key": "complete",
      "label": "Complete"
    }
  ],
  "form": {
    "fields": [
      {
        "name": "identity_domain_id",
        "label": "Identity Domain",
        "type": "select",
        "required": true,
        "options_source": "oci_identity_domains",
        "pattern": "^ocid1\\.domain\\.[A-Za-z0-9_.-]+$"
      },
      {
        "name": "aidp_mode",
        "label": "AI Data Platform",
        "type": "select",
        "required": true,
        "options": [
          {
            "value": "new",
            "label": "Create new platform"
          },
          {
            "value": "existing",
            "label": "Use existing platform"
          }
        ],
        "default": "new"
      },
      {
        "name": "existing_ai_data_platform_ocid",
        "label": "Existing AIDP OCID",
        "type": "text",
        "required": true,
        "visible_when": {
          "field": "aidp_mode",
          "equals": "existing"
        }
      },
      {
        "name": "existing_workspace_key",
        "label": "Existing workspace key",
        "type": "text",
        "required": true,
        "visible_when": {
          "field": "aidp_mode",
          "equals": "existing"
        }
      },
      {
        "name": "existing_catalog_key",
        "label": "Exact existing catalog key (optional)",
        "type": "text",
        "required": false
      },
      {
        "name": "admin_user_ocid",
        "label": "Administrator (new platform: assignment verified after bootstrap)",
        "type": "select",
        "required": true,
        "options_source": "oci_aidp_administrators"
      },
      {
        "name": "name",
        "label": "Stable product resource prefix",
        "type": "text",
        "required": true,
        "default": "aidp-gods-eye-view"
      },
      {
        "name": "create_buckets",
        "label": "Create the five selected buckets",
        "type": "boolean",
        "required": true,
        "default": true
      },
      {
        "name": "landing_bucket_name",
        "label": "Landing bucket name",
        "type": "text",
        "required": true
      },
      {
        "name": "bronze_bucket_name",
        "label": "Bronze bucket name",
        "type": "text",
        "required": true
      },
      {
        "name": "silver_bucket_name",
        "label": "Silver bucket name",
        "type": "text",
        "required": true
      },
      {
        "name": "gold_bucket_name",
        "label": "Gold bucket name",
        "type": "text",
        "required": true
      },
      {
        "name": "artifacts_bucket_name",
        "label": "Operational artifacts bucket name",
        "type": "text",
        "required": true
      },
      {
        "name": "agent_model_id",
        "label": "OCI agent model ID",
        "type": "text",
        "required": true
      },
      {
        "name": "release_tag",
        "label": "Stable immutable product release",
        "type": "text",
        "required": true,
        "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
      }
    ],
    "groups": [
      {
        "id": "credentials",
        "title": "OCI credentials",
        "items": [
          {
            "kind": "control",
            "name": "oci_config",
            "label": "OCI config"
          },
          {
            "kind": "control",
            "name": "oci_key",
            "label": "API private key"
          }
        ]
      },
      {
        "id": "services",
        "title": "Services to deploy",
        "items": [
          {
            "kind": "control",
            "name": "oci_region",
            "label": "OCI Region",
            "span": 2
          },
          {
            "kind": "control",
            "name": "compartment_mode",
            "label": "Compartment mode",
            "options": [
              {
                "value": "new",
                "label": "New compartment"
              },
              {
                "value": "existing",
                "label": "Existing compartment"
              }
            ]
          },
          {
            "kind": "control",
            "name": "new_compartment",
            "label": "New compartment name"
          },
          {
            "kind": "control",
            "name": "existing_compartment",
            "label": "Existing compartment"
          }
        ]
      },
      {
        "id": "configuration",
        "title": "Configuration",
        "items": [
          {
            "kind": "field",
            "name": "identity_domain_id",
            "span": 1
          },
          {
            "kind": "field",
            "name": "aidp_mode",
            "span": 1
          },
          {
            "kind": "field",
            "name": "existing_ai_data_platform_ocid",
            "span": 1
          },
          {
            "kind": "field",
            "name": "existing_workspace_key",
            "span": 1
          },
          {
            "kind": "field",
            "name": "existing_catalog_key",
            "span": 1
          },
          {
            "kind": "field",
            "name": "admin_user_ocid",
            "span": 1
          },
          {
            "kind": "field",
            "name": "name",
            "span": 1
          },
          {
            "kind": "field",
            "name": "create_buckets",
            "span": 1
          },
          {
            "kind": "field",
            "name": "landing_bucket_name",
            "span": 1
          },
          {
            "kind": "field",
            "name": "bronze_bucket_name",
            "span": 1
          },
          {
            "kind": "field",
            "name": "silver_bucket_name",
            "span": 1
          },
          {
            "kind": "field",
            "name": "gold_bucket_name",
            "span": 1
          },
          {
            "kind": "field",
            "name": "artifacts_bucket_name",
            "span": 1
          },
          {
            "kind": "field",
            "name": "agent_model_id",
            "span": 1
          },
          {
            "kind": "field",
            "name": "release_tag",
            "span": 1
          }
        ]
      }
    ]
  },
  "outputs": [
    "ai_data_platform_id",
    "instance_id",
    "public_origin",
    "admin_user_ocid",
    "identity_domain_id",
    "existing_workspace_key",
    "default_workspace_name",
    "objectstorage_namespace",
    "medallion_bucket_names",
    "artifacts_bucket_name",
    "compartment_ocid",
    "identity_domain_url",
    "gods_eye_view_group_id",
    "viewer_oidc_app_name",
    "agent_model_id",
    "workspace_key",
    "application_url",
    "gods_eye_view_native_status",
    "gods_eye_view_snapshot_version",
    "viewer_certificate_sha256",
    "viewer_certificate_pem"
  ],
  "preflight": {
    "entrypoint": "terraform/hooks/preflight.py",
    "requires_oci_credentials": true,
    "timeout_seconds": 900,
    "output_inputs": [
      "identity_domain_url",
      "home_region",
      "operator_user_ocid",
      "operator_fingerprint",
      "medallion_bucket_names",
      "image_ocid",
      "availability_domain",
      "vm_bundle_object",
      "vm_bundle_sha256"
    ],
    "runtime_fields": [
      {
        "name": "identity_domain_url",
        "label": "Verified Identity Domain endpoint",
        "type": "text",
        "required": true
      },
      {
        "name": "home_region",
        "label": "Tenancy home region",
        "type": "text",
        "required": true
      },
      {
        "name": "operator_user_ocid",
        "label": "Authorized deployment operator",
        "type": "text",
        "required": true
      },
      {
        "name": "operator_fingerprint",
        "label": "Authorized operator fingerprint",
        "type": "text",
        "required": true
      },
      {
        "name": "medallion_bucket_names",
        "label": "Verified medallion bucket bindings",
        "type": "text",
        "required": true
      },
      {
        "name": "image_ocid",
        "label": "Verified image ocid",
        "type": "text",
        "required": true
      },
      {
        "name": "availability_domain",
        "label": "Verified availability domain",
        "type": "text",
        "required": true
      },
      {
        "name": "vm_bundle_object",
        "label": "Verified vm bundle object",
        "type": "text",
        "required": true
      },
      {
        "name": "vm_bundle_sha256",
        "label": "Verified vm bundle sha256",
        "type": "text",
        "required": true
      }
    ],
    "secret_inputs": [],
    "release_assets": [
      {
        "name": "gods-eye-view-api-release.json",
        "max_bytes": 65536,
        "download": true
      },
      {
        "name": "gods-eye-view-api-image-amd64.tar.gz",
        "max_bytes": 536870912,
        "download": false
      },
      {
        "name": "gods-eye-view-release.json",
        "max_bytes": 65536,
        "download": true
      },
      {
        "name": "gods-eye-view-image-amd64.tar.gz",
        "max_bytes": 1073741824,
        "download": false
      },
      {
        "name": "gods-eye-view-gateway-release.json",
        "max_bytes": 65536,
        "download": true
      },
      {
        "name": "gods-eye-view-gateway-image-amd64.tar.gz",
        "max_bytes": 134217728,
        "download": false
      }
    ]
  },
  "post_apply": {
    "entrypoint": "terraform/hooks/post_apply.py",
    "requires_oci_credentials": true,
    "timeout_seconds": 3600,
    "include_paths": [
      "apps/backend/app/modules/ai_gods_eye_view/runtime",
      "apps/backend/app/modules/ai_gods_eye_view/package/lab.json",
      "apps/backend/app/modules/ai_gods_eye_view/package/notebooks",
      "apps/backend/app/modules/ai_gods_eye_view/package/source/social_networks/v1/manifest.json",
      "apps/backend/app/modules/ai_gods_eye_view/package/source/social_networks/v2/manifest.json",
      "apps/backend/app/modules/ai_gods_eye_view/package/source/sensors/colombia/v1/manifest.json",
      "apps/backend/app/__init__.py",
      "apps/backend/app/config.py",
      "apps/backend/app/api/viewer_identity.py",
      "apps/backend/app/security.py",
      "apps/backend/app/services/oci/aidp.py",
      "apps/backend/app/services/oci/identity.py",
      "apps/backend/app/services/oci/contracts.py",
      "apps/backend/app/packages",
      "scripts/deployment",
      "docker/bootstrap.sh",
      "docker/compose.yml"
    ],
    "secret_inputs": [],
    "release_assets": [
      {
        "name": "gods-eye-view-api-release.json",
        "max_bytes": 65536,
        "download": true
      },
      {
        "name": "gods-eye-view-api-image-amd64.tar.gz",
        "max_bytes": 536870912,
        "download": true
      },
      {
        "name": "gods-eye-view-release.json",
        "max_bytes": 65536,
        "download": true
      },
      {
        "name": "gods-eye-view-image-amd64.tar.gz",
        "max_bytes": 1073741824,
        "download": true
      },
      {
        "name": "gods-eye-view-gateway-release.json",
        "max_bytes": 65536,
        "download": true
      },
      {
        "name": "gods-eye-view-gateway-image-amd64.tar.gz",
        "max_bytes": 134217728,
        "download": true
      }
    ]
  }
}
